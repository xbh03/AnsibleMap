# Required
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ansiblemap
BITBUCKET_DEPLOYMENT=cloud
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_USERNAME=my-user
BITBUCKET_APP_PASSWORD=my-app-password
# Optional fallback for cloud auth
# BITBUCKET_TOKEN=your-cloud-token

# Required for cloud mode
BITBUCKET_WORKSPACE=my-workspace

# Optional for datacenter mode
# BITBUCKET_BASE_URL=https://bitbucket.company.tld
# BITBUCKET_TOKEN=your-token
# BITBUCKET_PASSWORD=your-password

# Optional project split by artifact type
BITBUCKET_PROJECT_PLAYBOOKS=OPSPLAY
BITBUCKET_PROJECT_ROLES=OPSROLE
BITBUCKET_PROJECT_COLLECTIONS=OPSCOLL

# Optional
REQUEST_TIMEOUT_SECONDS=30
MAX_FILES_PER_REPO=2000
MAX_FILE_SIZE_BYTES=1048576
